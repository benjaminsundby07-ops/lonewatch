{
  "_kommentar": [
    "Kopier til .mcp.json og lim inn den samme LONEWATCH_AGENT_KEY som",
    "terminalen der `python -m ui` kjorer. .mcp.json ligger i .gitignore,",
    "nettopp fordi noekkelen staar i den. Se docs/EKTE_AGENT.md.",
    "Pek 'command' paa det Python-miljoeet der `pip install -r requirements.txt`",
    "er kjort - MCP-tjeneren trenger pakken `mcp`."
  ],
  "mcpServers": {
    "lonewatch": {
      "command": "../lonewatch/.venv/bin/python",
      "args": ["-m", "agent_gateway"],
      "env": {
        "LONEWATCH_AGENT_KEY": "LIM INN NOEKKELEN HER",
        "LONEWATCH_AGENT_URL": "http://127.0.0.1:8000",
        "LONEWATCH_AGENT_WAIT_SECONDS": "120",
        "PYTHONPATH": "."
      }
    }
  }
}
